# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin
ADMIN_EMAILS=admin@example.com

# Mapbox (proxy côté serveur, jamais exposé au client)
MAPBOX_TOKEN=pk.your-mapbox-token

# GitHub (optionnel, pour le changelog — augmente le rate limit API)
GITHUB_TOKEN=ghp_your-github-token

# Cron job (secret partagé avec Vercel Cron)
CRON_SECRET=your-cron-secret

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Resend (emails transactionnels)
RESEND_API_KEY=re_your-resend-key

# Upstash Redis (rate limiting distribué — auto-injecté via Vercel Marketplace)
KV_REST_API_URL=https://your-redis.upstash.io
KV_REST_API_TOKEN=your-upstash-token
